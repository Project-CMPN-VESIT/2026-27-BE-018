# Copy to ".env" and edit. Every setting is optional; defaults shown.

# ---- inference ----
# GLN_DEVICE=cpu                 # cpu | cuda
# GLN_TORCH_THREADS=0            # 0 = automatic
# GLN_BATCH_SIZE=4
# GLN_TILE_OVERLAP=64            # px overlap between 256 px tiles

# ---- detection defaults (users can override per run in the UI) ----
# GLN_DEBRIS_THRESHOLD=0.5
# GLN_MIN_CLUSTER_PIXELS=3
# GLN_MASK_LAND=true
# GLN_MASK_CLOUDS=true

# ---- imagery cache: re-running the same area + scene skips the download ----
# GLN_CACHE_MAX_GB=5               # 0 disables; stored in data/cache (least-recently-used entries evicted)

# ---- limits ----
# GLN_MAX_AOI_KM2=400
# GLN_MAX_UPLOAD_MB=1024

# ---- imagery ----
# GLN_DEFAULT_PROVIDER=stac       # stac | gee | upload
# GLN_STAC_URL=https://earth-search.aws.element84.com/v1
# GLN_STAC_COLLECTION=sentinel-2-l2a

# ---- Google Earth Engine (see docs/GEE_SETUP.md) ----
# GLN_GEE_ENABLED=true
# GLN_GEE_PROJECT=my-gcp-project
# GLN_GEE_SERVICE_ACCOUNT=gln-reader@my-gcp-project.iam.gserviceaccount.com
# GLN_GEE_KEY_FILE=C:\GLN\secrets\gee-key.json        (local run; Docker uses /secrets/gee-key.json)

# ---- API / security ----
# GLN_API_KEY=                    # set to require an X-API-Key header (UI will ask for it once)
# GLN_CORS_ORIGINS=["http://localhost:5173"]
# GLN_LOG_LEVEL=INFO
